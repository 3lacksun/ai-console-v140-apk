{
  "expo": {
    "name": "AI Console",
    "slug": "ai-console",
    "version": "1.4.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f8fafc",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.nexarenew.aiconsole",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f8fafc"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AI Console to use your microphone for voice input.",
          "speechRecognitionPermission": "Allow AI Console to convert your speech into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Console to select images for the active attachment session.",
          "cameraPermission": "Allow AI Console to capture images for the active attachment session."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}

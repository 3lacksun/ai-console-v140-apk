{
  "expo": {
    "name": "Dr Stone's Command Centre",
    "slug": "command-centre",
    "version": "1.5.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.nexarenew.aiconsole",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Console to select images for the active attachment session.",
          "cameraPermission": "Allow AI Console to capture images for the active attachment session."
        }
      ],
      "expo-secure-store",
      "./plugins/withDisallowBackup",
      "./plugins/with16kbPageSize",
      "./plugins/withExcludeUnsafeNativeModules",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}

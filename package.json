{
  "name": "command-centre",
  "version": "1.5.4",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:apk": "node scripts/build-apk-policy.mjs",
